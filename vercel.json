{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "accounts/**",
          "cart/**",
          "orders/**",
          "products/**",
          "quotes/**",
          "ecommercesite/**",
          "templates/**",
          "static/**",
          "staticfiles/**",
          "mediafiles/products/**",
          "manage.py"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
